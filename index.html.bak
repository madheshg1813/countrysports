<!DOCTYPE html>

<html class="dark" lang="en">

<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>Country Sports - Badminton Racket Experts</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Lexend:wght@300;400;500;600;700;800;900&amp;display=swap"
        rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght@100..700,0..1&amp;display=swap"
        rel="stylesheet" />
    <link
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
        rel="stylesheet" />
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#59f20d",
                        "background-light": "#f6f8f5",
                        "background-dark": "#162210",
                    },
                    fontFamily: {
                        "display": ["Lexend"]
                    },
                    borderRadius: { "DEFAULT": "0.25rem", "lg": "0.5rem", "xl": "0.75rem", "full": "9999px" },
                },
            },
        }
    </script>
    <style>
        body {
            min-height: max(884px, 100dvh);
        }
    </style>
</head>

<body
    class="bg-background-light dark:bg-background-dark font-display text-slate-900 dark:text-slate-100 antialiased overflow-x-hidden">
    <!-- Sticky Header -->
    <header
        class="sticky top-0 z-50 w-full bg-background-light/80 dark:bg-background-dark/80 backdrop-blur-md border-b border-primary/10">
        <div class="flex items-center justify-between px-4 py-3 max-w-7xl mx-auto">
            <div class="flex items-center gap-2">
                <span class="material-symbols-outlined text-primary text-3xl">sports_tennis</span>
                <h1 class="text-lg font-black tracking-tighter uppercase">Country Sports</h1>
            </div>
            <div class="flex items-center gap-3">
                <button
                    class="bg-primary text-background-dark px-4 py-2 rounded-lg text-sm font-bold shadow-lg shadow-primary/20">
                    Book Now
                </button>
            </div>
        </div>
    </header>
    <main class="w-full">
        <!-- Hero Section -->
        <section class="relative px-4 py-12 @container">
            <div class="flex flex-col gap-8 @[864px]:flex-row @[864px]:items-center">
                <div class="w-full aspect-[4/3] rounded-2xl overflow-hidden shadow-2xl border border-primary/20 bg-primary/10"
                    data-alt="Professional badminton racket being strung on a digital machine"
                    style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuACPrqWV73N-eDEUlhHZJ0_oCRnQGjsH6zETaO08kvZ7PsSkrQ5GqVq_r9rBLMmshmURHeCsiqz_8a_I64WNqOqNp16-DyVVMCtBxszotMwm22i5pfjiTKdpl5gK3w77CGzwsKCIxlCG4fNHToq72PA9yUlRbHZnuTD7lkOSkuslWlH3Hy9ac7DYoLhCtJPEo5feOlSMf8wh5bECEeHUKEZD2n6C3q5SCupkquMef7nfp4TVhHy2-lj_9U2hjYpdF-2rJp830lqlI51'); background-size: cover; background-position: center;">
                </div>
                <div class="flex flex-col gap-6">
                    <div
                        class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-primary/10 border border-primary/30 text-primary w-fit">
                        <span class="relative flex h-2 w-2">
                            <span
                                class="animate-ping absolute inline-flex h-full w-full rounded-full bg-primary opacity-75"></span>
                            <span class="relative inline-flex rounded-full h-2 w-2 bg-primary"></span>
                        </span>
                        <span class="text-[10px] font-bold tracking-widest uppercase">Chennai's #1 Stringer @ Country
                            Sports</span>
                    </div>
                    <h1 class="text-4xl @[480px]:text-6xl font-black leading-[1.1] tracking-tight">
                        Precision Stringing. <span class="text-primary">Maximum Power.</span>
                    </h1>
                    <p class="text-slate-600 dark:text-slate-400 text-base @[480px]:text-lg leading-relaxed max-w-xl">
                        Professional badminton racket stringing in Chennai. Expert tension control for your winning
                        edge. Same-day service available.
                    </p>
                    <div class="flex flex-col @[480px]:flex-row gap-4">
                        <button
                            class="bg-primary text-background-dark h-14 px-8 rounded-xl font-extrabold text-base flex items-center justify-center gap-2">
                            Book Stringing Now
                            <span class="material-symbols-outlined">bolt</span>
                        </button>
                        <button class="bg-slate-200 dark:bg-slate-800 h-14 px-8 rounded-xl font-bold text-base">
                            View Pricing
                        </button>
                    </div>
                </div>
            </div>
        </section>
        <!-- About / Expertise Section -->
        <section class="px-4 py-16 bg-primary/5">
            <div class="max-w-xl mx-auto text-center flex flex-col gap-4">
                <h2 class="text-3xl font-bold">Professional Expertise</h2>
                <div class="w-16 h-1 bg-primary mx-auto rounded-full"></div>
                <p class="text-slate-600 dark:text-slate-400 leading-loose">
                    Specializing in precision tension control and professional gutting using world-class equipment to
                    enhance your performance on court. We understand that every pound of tension matters.
                </p>
            </div>
        </section>
        <!-- Services Grid -->
        <section class="px-4 py-16 grid grid-cols-1 md:grid-cols-2 gap-4">
            <div
                class="p-6 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm flex flex-col gap-4 group hover:border-primary/50 transition-colors">
                <div class="size-12 rounded-xl bg-primary/10 flex items-center justify-center text-primary">
                    <span class="material-symbols-outlined text-3xl">sports_handball</span>
                </div>
                <h3 class="text-xl font-bold">Racket Re-Stringing</h3>
                <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed">Precision stringing for all brands
                    including Yonex, Victor, and Li-Ning.</p>
            </div>
            <div
                class="p-6 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm flex flex-col gap-4 group hover:border-primary/50 transition-colors">
                <div class="size-12 rounded-xl bg-primary/10 flex items-center justify-center text-primary">
                    <span class="material-symbols-outlined text-3xl">settings_input_component</span>
                </div>
                <h3 class="text-xl font-bold">Custom Tension</h3>
                <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed">Exact tension matching based on
                    your playstyle - Power or Control focused.</p>
            </div>
            <div
                class="p-6 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm flex flex-col gap-4 group hover:border-primary/50 transition-colors">
                <div class="size-12 rounded-xl bg-primary/10 flex items-center justify-center text-primary">
                    <span class="material-symbols-outlined text-3xl">workspace_premium</span>
                </div>
                <h3 class="text-xl font-bold">Premium Strings</h3>
                <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed">In-stock availability of BG65,
                    BG80, Nanogy, and Aerobite series.</p>
            </div>
            <div
                class="p-6 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm flex flex-col gap-4 group hover:border-primary/50 transition-colors">
                <div class="size-12 rounded-xl bg-primary/10 flex items-center justify-center text-primary">
                    <span class="material-symbols-outlined text-3xl">schedule</span>
                </div>
                <h3 class="text-xl font-bold">Same-Day Service</h3>
                <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed">Drop off in the morning, ready for
                    your evening match. Express available.</p>
            </div>
        </section>
        <!-- Why Choose Us -->
        <section class="px-4 py-16 bg-slate-100 dark:bg-slate-900/50">
            <h2 class="text-2xl font-black mb-8">Why Country Sports?</h2>
            <div class="space-y-4">
                <div class="flex items-center gap-4 p-4 rounded-xl bg-white dark:bg-slate-900">
                    <div class="bg-primary rounded-full size-6 flex items-center justify-center">
                        <span class="material-symbols-outlined text-background-dark text-sm font-bold">check</span>
                    </div>
                    <span class="font-bold">Digital Tension Machine</span>
                </div>
                <div class="flex items-center gap-4 p-4 rounded-xl bg-white dark:bg-slate-900">
                    <div class="bg-primary rounded-full size-6 flex items-center justify-center">
                        <span class="material-symbols-outlined text-background-dark text-sm font-bold">check</span>
                    </div>
                    <span class="font-bold">Certified Expert Technician</span>
                </div>
                <div class="flex items-center gap-4 p-4 rounded-xl bg-white dark:bg-slate-900">
                    <div class="bg-primary rounded-full size-6 flex items-center justify-center">
                        <span class="material-symbols-outlined text-background-dark text-sm font-bold">check</span>
                    </div>
                    <span class="font-bold">Fast 24-Hour Turnaround</span>
                </div>
            </div>
        </section>
        <!-- Pricing Section -->
        <section class="px-4 py-16 flex flex-col gap-8">
            <div class="text-center">
                <h2 class="text-3xl font-black">Stringing Tiers</h2>
                <p class="text-slate-500 mt-2">Professional labor included</p>
            </div>
            <div class="flex flex-col gap-6">
                <!-- Tier 1 -->
                <div
                    class="p-8 rounded-3xl bg-slate-100 dark:bg-slate-900 border border-slate-200 dark:border-slate-800">
                    <h3 class="text-lg font-bold">Standard</h3>
                    <div class="flex items-baseline gap-1 mt-4 mb-6">
                        <span class="text-3xl font-black text-primary">₹350</span>
                        <span class="text-slate-500">+ String Cost</span>
                    </div>
                    <ul class="space-y-3 mb-8 text-sm">
                        <li class="flex items-center gap-2"><span
                                class="material-symbols-outlined text-primary size-4">check</span> Digital Tension
                            Control</li>
                        <li class="flex items-center gap-2"><span
                                class="material-symbols-outlined text-primary size-4">check</span> 24h Turnaround</li>
                        <li class="flex items-center gap-2"><span
                                class="material-symbols-outlined text-primary size-4">check</span> Single Racket Care
                        </li>
                    </ul>
                    <button class="w-full py-3 rounded-xl border border-primary text-primary font-bold">Select</button>
                </div>
                <!-- Tier 2 -->
                <div
                    class="p-8 rounded-3xl bg-primary text-background-dark border-4 border-primary shadow-2xl shadow-primary/30 relative overflow-hidden">
                    <div
                        class="absolute top-4 right-4 bg-background-dark text-primary text-[10px] font-black px-2 py-1 rounded-full uppercase tracking-tighter">
                        Popular</div>
                    <h3 class="text-lg font-bold">Premium Express</h3>
                    <div class="flex items-baseline gap-1 mt-4 mb-6">
                        <span class="text-3xl font-black">₹600</span>
                        <span class="opacity-70 font-medium">+ String Cost</span>
                    </div>
                    <ul class="space-y-3 mb-8 text-sm">
                        <li class="flex items-center gap-2 font-semibold"><span
                                class="material-symbols-outlined size-4">bolt</span> 3-Hour Express Service</li>
                        <li class="flex items-center gap-2 font-semibold"><span
                                class="material-symbols-outlined size-4">check</span> Full Grommet Check</li>
                        <li class="flex items-center gap-2 font-semibold"><span
                                class="material-symbols-outlined size-4">check</span> Tension Retention Coating</li>
                    </ul>
                    <button class="w-full py-3 rounded-xl bg-background-dark text-primary font-black shadow-lg">Book
                        Express</button>
                </div>
            </div>
        </section>
        <!-- Process Timeline -->
        <section class="px-4 py-16 bg-background-light dark:bg-background-dark">
            <h2 class="text-2xl font-black mb-10 text-center">The Pro Process</h2>
            <div
                class="relative space-y-12 before:absolute before:left-[19px] before:top-4 before:h-[calc(100%-24px)] before:w-0.5 before:bg-primary/20">
                <div class="relative flex gap-6">
                    <div
                        class="flex-none size-10 rounded-full bg-primary flex items-center justify-center font-black text-background-dark z-10 shadow-lg shadow-primary/20">
                        1</div>
                    <div>
                        <h4 class="font-bold text-lg">Choose Your String</h4>
                        <p class="text-slate-500 text-sm mt-1">Select from our range of high-performance strings or
                            bring your own.</p>
                    </div>
                </div>
                <div class="relative flex gap-6">
                    <div
                        class="flex-none size-10 rounded-full bg-primary flex items-center justify-center font-black text-background-dark z-10 shadow-lg shadow-primary/20">
                        2</div>
                    <div>
                        <h4 class="font-bold text-lg">Set Your Tension</h4>
                        <p class="text-slate-500 text-sm mt-1">Consult with our expert to find the perfect LBS for your
                            racket model.</p>
                    </div>
                </div>
                <div class="relative flex gap-6">
                    <div
                        class="flex-none size-10 rounded-full bg-primary flex items-center justify-center font-black text-background-dark z-10 shadow-lg shadow-primary/20">
                        3</div>
                    <div>
                        <h4 class="font-bold text-lg">Precision Stringing</h4>
                        <p class="text-slate-500 text-sm mt-1">Our digital constant-pull machine ensures tension
                            accuracy to 0.1 lbs.</p>
                    </div>
                </div>
                <div class="relative flex gap-6">
                    <div
                        class="flex-none size-10 rounded-full bg-primary flex items-center justify-center font-black text-background-dark z-10 shadow-lg shadow-primary/20">
                        4</div>
                    <div>
                        <h4 class="font-bold text-lg">Ready to Play</h4>
                        <p class="text-slate-500 text-sm mt-1">Pick up your racket and feel the immediate difference on
                            court.</p>
                    </div>
                </div>
            </div>
        </section>
        <!-- Testimonials -->
        <section class="px-4 py-16 bg-slate-100 dark:bg-slate-900/50">
            <h2 class="text-2xl font-black mb-8">Court Champions Say</h2>
            <div class="flex overflow-x-auto gap-4 pb-4 snap-x">
                <div
                    class="min-w-[80%] snap-center p-6 bg-white dark:bg-slate-900 rounded-2xl shadow-sm border border-slate-200 dark:border-slate-800">
                    <div class="flex text-primary mb-4">
                        <span class="material-symbols-outlined">star</span>
                        <span class="material-symbols-outlined">star</span>
                        <span class="material-symbols-outlined">star</span>
                        <span class="material-symbols-outlined">star</span>
                        <span class="material-symbols-outlined">star</span>
                    </div>
                    <p class="italic text-slate-600 dark:text-slate-400 mb-4">"Best stringing service in Velachery. My
                        Nanoflare 800 feels incredible with the 28lbs tension they set."</p>
                    <p class="font-black">- Rahul S.</p>
                </div>
                <div
                    class="min-w-[80%] snap-center p-6 bg-white dark:bg-slate-900 rounded-2xl shadow-sm border border-slate-200 dark:border-slate-800">
                    <div class="flex text-primary mb-4">
                        <span class="material-symbols-outlined">star</span>
                        <span class="material-symbols-outlined">star</span>
                        <span class="material-symbols-outlined">star</span>
                        <span class="material-symbols-outlined">star</span>
                        <span class="material-symbols-outlined">star</span>
                    </div>
                    <p class="italic text-slate-600 dark:text-slate-400 mb-4">"Same-day service saved me before my
                        tournament. Perfect tension consistency across the bed."</p>
                    <p class="font-black">- Ananya K.</p>
                </div>
            </div>
        </section>
        <!-- Location & Contact -->
        <section class="px-4 py-16 space-y-8">
            <h2 class="text-2xl font-black">Visit Our Workshop</h2>
            <div class="w-full h-48 bg-slate-200 dark:bg-slate-800 rounded-2xl overflow-hidden relative border border-slate-200 dark:border-slate-800"
                data-location="Chennai">
                <div class="absolute inset-0 flex items-center justify-center text-slate-400 font-bold">
                    <span class="material-symbols-outlined mr-2">map</span> Country Sports - Velachery
                </div>
            </div>
            <div class="grid grid-cols-2 gap-4">
                <div class="p-4 bg-slate-100 dark:bg-slate-900 rounded-xl">
                    <h5 class="font-bold text-xs uppercase tracking-widest text-primary mb-2">Hours</h5>
                    <p class="text-sm">Mon-Sat<br />10:00 AM - 08:00 PM</p>
                </div>
                <div class="p-4 bg-slate-100 dark:bg-slate-900 rounded-xl">
                    <h5 class="font-bold text-xs uppercase tracking-widest text-primary mb-2">Location</h5>
                    <p class="text-sm">Velachery<br />No. 13, 12th Street, Ashtalakshmi Nagar</p>
                </div>
            </div>
            <a class="flex items-center justify-center gap-2 w-full bg-[#25D366] text-white py-4 rounded-xl font-black text-lg shadow-lg"
                href="#">
                <svg class="size-6 fill-current" viewbox="0 0 24 24">
                    <path
                        d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766 0-3.18-2.587-5.771-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217s.231.001.332.005c.109.004.258-.041.404.314.159.386.541 1.32.588 1.417.049.098.082.211.017.339-.063.127-.095.208-.188.319-.093.11-.197.247-.28.332-.093.098-.191.205-.082.392.11.188.489.807 1.047 1.303.718.639 1.32.837 1.508.925.188.087.299.073.41-.053.11-.127.473-.55.599-.739.127-.188.252-.159.424-.095.172.064 1.092.515 1.28.608.188.093.314.139.359.218.046.078.046.452-.098.857zM12 1c-6.075 0-11 4.925-11 11s4.925 11 11 11 11-4.925 11-11-4.925-11-11-11zm0 20c-4.963 0-9-4.037-9-9s4.037-9 9-9 9 4.037 9 9-4.037 9-9 9z">
                    </path>
                </svg>
                WhatsApp Us
            </a>
        </section>
        <!-- Final CTA Banner -->
        <section class="px-4 pb-24">
            <div
                class="relative rounded-3xl bg-background-dark border border-primary/40 overflow-hidden p-10 text-center">
                <div class="absolute inset-0 bg-primary/10 pointer-events-none"></div>
                <div class="relative z-10 flex flex-col gap-6">
                    <h2 class="text-3xl font-black">Get Back on Court with Perfect Tension.</h2>
                    <div class="flex flex-col gap-6">
                        <p class="text-slate-400">Join 500+ badminton players in Chennai who trust us with their
                            rackets.</p>
                        <button
                            class="bg-primary text-background-dark py-4 px-10 rounded-2xl font-black text-lg self-center shadow-xl shadow-primary/40">
                            Book Your Slot
                        </button>
                    </div>
                </div>
            </div>
        </section>
    </main>
    <!-- Bottom Navigation Bar -->
    <nav
        class="fixed bottom-0 w-full z-50 bg-background-light dark:bg-background-dark border-t border-primary/10 px-4 pb-6 pt-2 flex justify-around items-center">
        <a class="flex flex-col items-center gap-1 text-primary" href="#">
            <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1">home</span>
            <span class="text-[10px] font-bold">Home</span>
        </a>
        <a class="flex flex-col items-center gap-1 text-slate-400" href="#">
            <span class="material-symbols-outlined">sports_tennis</span>
            <span class="text-[10px] font-bold">Services</span>
        </a>
        <a class="flex flex-col items-center gap-1 text-slate-400" href="#">
            <span class="material-symbols-outlined">payments</span>
            <span class="text-[10px] font-bold">Pricing</span>
        </a>
        <a class="flex flex-col items-center gap-1 text-slate-400" href="#">
            <span class="material-symbols-outlined">chat</span>
            <span class="text-[10px] font-bold">Contact</span>
        </a>
    </nav>
</body>

</html>