# Copy to .env.local and fill in real values.

# WhatsApp number in full international format: digits only, no "+", spaces or
# punctuation. Example format for India: 91XXXXXXXXXX (country code + number).
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Production origin used for canonical URLs, Open Graph and the sitemap,
# e.g. https://www.example.com (no trailing slash).
NEXT_PUBLIC_SITE_URL=
